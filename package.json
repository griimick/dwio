{
  "name": "dwio",
  "version": "0.1.0",
  "description": "Edit local .drawio and .drawio.svg files in the draw.io editor, served fully offline from your terminal.",
  "license": "MIT",
  "repository": "github:griimick/dwio",
  "type": "module",
  "scripts": {
    "dev": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "build": "bun scripts/build-binaries.ts",
    "build:all": "bun scripts/build-binaries.ts --all",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  },
  "private": true
}
